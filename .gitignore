# GitHub-visible allowlist.
# Keep the branch surface limited to app/, ml/, docs/, and root essentials.

# Hide everything at the repository root by default.
/*
/.*

# Root essentials that should remain visible.
!/.gitignore
!/README.md
!/requirements.txt
!/dataload.py
!/CLAUDE.md

# Public project areas.
!/app/
!/app/**
!/ml/
!/ml/**
!/docs/
!/docs/**
!/docs_web/
!/docs_web/**
!/valo_web_backend/
!/valo_web_backend/**
!/valo_web_frontend/
!/valo_web_frontend/**
!/.claude/
!/.claude/**

# Generated/local clutter stays private, including inside allowed trees.
__pycache__/
*.py[cod]
*$py.class
.DS_Store
.env
.env.*
.venv/
data/
logs/
models/
notebooks/
notice/
reports/
scripts/
tests/
.claude/settings.local.json
.codex/
.omc/
.omx/
.playwright-mcp/
*.joblib
*.pkl
*.db
*.sqlite
*.sqlite3

# Node / Next.js (valo_web_frontend) — 소스만 커밋, 빌드 산출물 제외
node_modules/
.next/
*.tsbuildinfo
next-env.d.ts
