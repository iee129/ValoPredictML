# GitHub-visible allowlist.
# Keep the branch surface limited to src/, web/, docs/, and root essentials.

# Hide everything at the repository root by default.
/*
/.*

# Root essentials that should remain visible.
!/.gitignore
!/.dockerignore
!/Dockerfile.presentation
!/README.md
!/requirements.txt
!/pyproject.toml
!/CLAUDE.md
!/deploy/
!/deploy/**

# Public project areas.
!/src/
!/src/**
!/docs/
!/docs/**
!/web/
!/web/**
# Generated/local clutter stays private, including inside allowed trees.
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.DS_Store
.env
.env.*
.venv/

# 루트 산출물 디렉토리만 숨김(루트 고정) — src/data 등 코드 디렉토리와 충돌 방지
/data/
/logs/
/models/
/notebooks/
/notice/
/reports/
/scripts/
/tests/

# AI 도구 로컬 상태 디렉토리 (Claude, Codex, Cursor, Aider 등)
.claude/
.codex/
.omc/
.omx/
.cursor/
.continue/
.codeium/
.windsurf/
.gemini/
.aider/
.aider.chat.history.md
.aider.input.history
.roomodes
.clinerules
.anthropic/
.playwright-mcp/
*.joblib
*.pkl
*.db
*.sqlite
*.sqlite3

# Node / Next.js (web) — 소스만 커밋, 빌드 산출물 제외
node_modules/
.next/
*.tsbuildinfo
next-env.d.ts
