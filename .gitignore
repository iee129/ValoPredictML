# GitHub-visible allowlist.
# Keep the branch surface limited to app/, ml/, docs/, and root essentials.

# Hide everything at the repository root by default.
/*
/.*

# Root essentials that should remain visible.
!/.gitignore
!/README.md
!/requirements.txt
!/dataload.py

# Public project areas.
!/app/
!/app/**
!/ml/
!/ml/**
!/docs/
!/docs/**

# Generated/local clutter stays private, including inside allowed trees.
__pycache__/
*.py[cod]
*$py.class
.DS_Store
.env
.env.*
.venv/
data/
logs/
models/
notice/
reports/
scripts/
tests/
.claude/
.codex/
.omc/
.omx/
.playwright-mcp/
*.joblib
*.pkl
*.db
*.sqlite
*.sqlite3
